# The API creates the database if this Postgres server is already running.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/flight_tracker

# Set to false if you want startup to fail when PostgreSQL is down.
ALLOW_SQLITE_FALLBACK=true

# Optional: skip PostgreSQL entirely and use a local file.
# DATABASE_URL=sqlite:///./flight_tracker.db

# Optional language-model parser. With no key, search text uses the rule parser.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
